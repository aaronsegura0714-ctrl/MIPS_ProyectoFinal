module TB_DPTR;
    reg clk;
    reg [31:0] instruction;
    wire [31:0] result;

    DPTR tb (
        .clk(clk),
        .instruction(instruction),
        .result(result)
    );
    initial begin
        tb.BR.regs[1] = 32'd10; 
        tb.BR.regs[2] = 32'd5;  
        tb.BR.regs[3] = 32'd0;  
    end

    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    initial begin
        $display("Inicio de simulación");
	//SUMA
        instruction = 32'h00221820; #10 $display("ADD $3,$1,$2 = %d", result);
        instruction = 32'h00411020; #10 $display("ADD $3,$2,$1 = %d", result);
	//RESTA
        instruction = 32'h00221822; #10 $display("SUB $3,$1,$2 = %d", result);
        instruction = 32'h00411022; #10 $display("SUB $3,$2,$1 = %d", result);
	//AND
        instruction = 32'h00221824; #10 $display("AND $3,$1,$2 = %d", result);
        instruction = 32'h00411024; #10 $display("AND $3,$2,$1 = %d", result);
	//OR
        instruction = 32'h00221825; #10 $display("OR $3,$1,$2 = %d", result);
        instruction = 32'h00411025; #10 $display("OR $3,$2,$1 = %d", result);
	//SLT
        instruction = 32'h0022182A; #10 $display("SLT $3,$1,$2 = %d", result);
        instruction = 32'h0041102A; #10 $display("SLT $3,$2,$1 = %d", result);

        $stop;
    end
endmodule

