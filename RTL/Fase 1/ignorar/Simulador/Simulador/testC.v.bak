module tb_bit4_c;

reg  [3:0] A;
reg  [3:0] B;
reg        c_in;
wire [4:0] S;

bit4_c uut (.A(A),.B(B),.c_in(c_in),.S(S)
);

initial begin
    $display("A   B   Cin |  S");
    $monitor("%d  %d   %d  |  %d", A, B, c_in, S);

    A=4'b0000; B=4'b0000; c_in=0; #10;
    A=4'b0011; B=4'b0101; c_in=0; #10;
    A=4'b1111; B=4'b0001; c_in=0; #10;
    A=4'b1010; B=4'b0101; c_in=1; #10;
    A=4'b1111; B=4'b1111; c_in=1; #10;

    $finish;
end

endmodule

